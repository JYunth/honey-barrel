{
  "manifest_version": 3,
  "name": "Honey Barrel",
  "description": "Compares wine & spirits prices across retail sites and the BAXUS marketplace.",
  "version": "0.5.0",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Honey Barrel",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://services.baxus.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.wine.com/*", "*://*.spiritory.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}