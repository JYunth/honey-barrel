{
  "manifest_version": 3,
  "name": "Honey Barrel",
  "description": "Compares wine & spirits prices across retail sites and the BAXUS marketplace.",
  "version": "0.2.0",
  "action": {
    "default_title": "Honey Barrel"
  },
  "content_scripts": [
    {
      "matches": ["*://*.wine.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}